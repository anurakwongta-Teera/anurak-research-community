---
import { render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import { entries, sectionPaths } from '../../lib/content';
import { url } from '../../lib/site';
export async function getStaticPaths() {
  return (
    await Promise.all(
      Object.entries(sectionPaths).map(async ([collection, section]) =>
        (await entries(collection as keyof typeof sectionPaths)).map(
          (entry) => ({
            params: { section, id: entry.id },
            props: { entry, section },
          }),
        ),
      ),
    )
  ).flat();
}
const { entry, section } = Astro.props;
const { Content } = await render(entry);
---

<Layout
  title={entry.data.title}
  description={entry.data.summary}
  active={`${section}/`}
>
  <article class="article shell">
    <a class="text-link" href={url(`${section}/`)}>
      ← Back to {section === 'laboratory' ? 'Laboratory & Innovation' : section}
    </a>
    <p class="eyebrow">{entry.data.category}</p>
    <h1>{entry.data.title}</h1>
    <p class="lede">{entry.data.summary}</p>
    {entry.data.placeholder && (
      <aside class="notice">
        <strong>Illustrative placeholder</strong>
        <p>
          This entry demonstrates the website structure. It does not describe a
          verified project, achievement, activity, or research finding.
        </p>
      </aside>
    )}
    {'stage' in entry.data && <p class="badge">Stage: {entry.data.stage}</p>}
    <div class="prose">
      <Content />
    </div>
    {'evidence' in entry.data && entry.data.evidence && (
      <div class="notice">
        <strong>Validation evidence</strong>
        <p>{entry.data.evidence}</p>
      </div>
    )}
  </article>
</Layout>
