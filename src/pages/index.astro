---
import Layout from '../layouts/Layout.astro';
import Illustration from '../components/Illustration.astro';
import Card from '../components/Card.astro';
import { entries } from '../lib/content';
import { url } from '../lib/site';
const projects = (await entries('projects'))
  .filter((e) => e.data.featured)
  .slice(0, 3);
const news = (await entries('news')).slice(0, 2);
---

<Layout>
  <section class="hero shell">
    <div class="hero-copy">
      <p class="eyebrow">
        <span class="dot"></span> RESEARCH WITH PEOPLE, FOR PEOPLE
      </p>
      <h1>
        Practical science.
        <br />
        <em>Real-world impact.</em>
      </h1>
      <p class="hero-description">
        Connecting environmental and occupational health, practical laboratory
        innovation, and community-based research.
      </p>
      <div class="actions">
        <a class="button" href={url('research/')}>
          Explore the research <span>↗</span>
        </a>
        <a class="text-link" href={url('contact/')}>
          Let’s collaborate <span>→</span>
        </a>
      </div>
      <div class="hero-note">
        <span class="line"></span>
        <p>
          Anurak Wongta
          <br />
          <strong>Academic researcher & research project leader</strong>
        </p>
      </div>
    </div>
    <figure class="hero-visual">
      <Illustration />
      <figcaption>
        <span>01 / FROM LABORATORY TO COMMUNITY</span>
        <span>Concept illustration</span>
      </figcaption>
    </figure>
  </section>
  <section class="focus-strip">
    <div class="shell">
      <span>ENVIRONMENT & HEALTH</span>
      <span aria-hidden="true">✳</span>
      <span>LABORATORY INNOVATION</span>
      <span aria-hidden="true">✳</span>
      <span>COMMUNITY CONNECTION</span>
    </div>
  </section>
  <section class="section shell">
    <div class="section-intro">
      <p class="eyebrow">A CONNECTED APPROACH</p>
      <h2>
        Good questions.
        <br />
        Meaningful possibilities.
      </h2>
      <p>
        Research connects careful measurement with the realities of everyday
        life. This work brings together three complementary areas of focus.
      </p>
    </div>
    <div class="three-grid pillars">
      {[
        [
          '01',
          'Research',
          'Understanding health in the places where people live and work.',
          'research/',
        ],
        [
          '02',
          'Laboratory & Innovation',
          'Developing practical methods with real-world use in mind.',
          'laboratory/',
        ],
        [
          '03',
          'Community',
          'Connecting scientific questions with community perspectives.',
          'community/',
        ],
      ].map(([n, title, copy, path]) => (
        <a class="pillar" href={url(path)}>
          <span class="pillar-number">{n} /</span>
          <h3>
            {title} <span>↗</span>
          </h3>
          <p>{copy}</p>
        </a>
      ))}
    </div>
  </section>
  <section class="section soft">
    <div class="shell">
      <div class="section-heading">
        <div>
          <p class="eyebrow">RESEARCH IN FOCUS</p>
          <h2>Questions worth exploring.</h2>
        </div>
        <a class="text-link" href={url('research/')}>
          All projects →
        </a>
      </div>
      <p class="section-note">
        Illustrative topics below show the intended research portfolio. Verified
        project details will be added after review.
      </p>
      <div class="three-grid">
        {projects.map((entry) => (
          <Card entry={entry} section="research" />
        ))}
      </div>
    </div>
  </section>
  <section class="section shell lab-feature">
    <div class="lab-panel">
      <span class="eyebrow">THE INNOVATION PATHWAY</span>
      <div class="pathway">
        <span>
          01 <strong>Concept</strong>
        </span>
        <span>↓</span>
        <span>
          02 <strong>Development</strong>
        </span>
        <span>↓</span>
        <span>
          03 <strong>Validation</strong>
        </span>
      </div>
      <p>Clear stages. Evidence at every step.</p>
    </div>
    <div>
      <p class="eyebrow">LABORATORY & INNOVATION</p>
      <h2>
        Practical tools.
        <br />A wider reach.
      </h2>
      <p>
        Explore low-cost measurement, assay development, and portable
        technologies designed around the needs of field and community settings.
      </p>
      <p>
        Every innovation is labeled by its stage, so an early idea is clearly
        distinguished from an evidence-supported outcome.
      </p>
      <a class="text-link" href={url('laboratory/')}>
        Inside the laboratory →
      </a>
    </div>
  </section>
  <section class="section shell">
    <div class="section-heading">
      <div>
        <p class="eyebrow">NOTES & ACTIVITIES</p>
        <h2>Latest updates.</h2>
      </div>
      <a class="text-link" href={url('news/')}>
        All updates →
      </a>
    </div>
    <div class="two-grid">
      {news.map((entry) => (
        <Card entry={entry} section="news" />
      ))}
    </div>
  </section>
  <section class="shell collaboration">
    <div>
      <p class="eyebrow">LET’S CONNECT</p>
      <h2>
        Better questions begin
        <br />
        with a conversation.
      </h2>
      <p>
        For research ideas, practical innovation, and community collaboration.
      </p>
    </div>
    <a class="button light" href={url('contact/')}>
      Explore collaboration ↗
    </a>
  </section>
</Layout>
